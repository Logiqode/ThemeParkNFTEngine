# =============================================================================
# ThemeParkNFTEngine — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env.
# =============================================================================

# --- App ---
APP_ENV=development
APP_NAME=theme-park-nft-engine
APP_PORT=8080
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=themepark
POSTGRES_PASSWORD=themepark_dev
POSTGRES_DB=themepark
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=25

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DEDUP_TTL_SECONDS=300
REDIS_GRACE_WINDOW_SECONDS=5
REDIS_AGG_TTL_SECONDS=172800

# --- Kafka ---
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC_RIDE_SCANS=ride-scans
KAFKA_TOPIC_DLQ=ride-scans-dlq
KAFKA_CONSUMER_GROUP=ride-scan-consumers
KAFKA_PARTITIONS=6
KAFKA_REPLICATION=1
KAFKA_RETENTION_MS=604800000
# KAFKA_PRODUCER_ASYNC=false — false = sync writes (per-batch delivery verified by benchmarks);
# true = fire-and-forget (Week 3 gate producer path). Errors surface via Writer.Stats().Errors.
KAFKA_PRODUCER_ASYNC=false
# KAFKA_CONSUMER_MAX_RETRIES — transient handler failure retries before DLQ (R14/D5).
KAFKA_CONSUMER_MAX_RETRIES=3
# KAFKA_CONSUMER_BACKOFF_MS — base retry backoff (ms), doubles each attempt (0.5s→1s→2s).
KAFKA_CONSUMER_BACKOFF_MS=500

# --- Gate / HMAC ---
HMAC_SECRET=change-me-to-a-32-byte-secret
QR_ROTATION_SECONDS=30
# GATE_TXN_CHECK_FAILWHEN — mock NFC transaction-check knob (R16): when set to a
# visitor email, that account's nfc-check fails (simulates faulty NFC/zkLogin).
# Empty = always pass. Real zkLogin (Week 6) ignores this.
GATE_TXN_CHECK_FAILWHEN=

# --- Sui Blockchain ---
SUI_RPC_URL=https://sui-testnet-endpoint.blockvision.org
SUI_NETWORK=testnet
SUI_PACKAGE_ID=
SUI_MINTCAP_ID=
SUI_GAS_POOL_MNEMONIC=
SUI_GAS_BUDGET=100000000
SUI_RPC_MAX_CONCURRENCY=5
SUI_RPC_MAX_RETRIES=5

# --- zkLogin ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ENCRYPTION_KEY=change-me-32-byte-encryption-key

# --- IPFS / Pinata ---
PINATA_API_KEY=
PINATA_API_SECRET=
# Bearer JWT token from the Pinata dashboard. Pinata now requires this over the
# legacy key/secret headers; when set the client authenticates with it.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# --- OpenTelemetry / Datadog ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=theme-park-nft-engine
DD_API_KEY=
DD_SITE=datadoghq.com

# --- AWS (Week 8) ---
AWS_REGION=us-east-1
AWS_ECR_REGISTRY=
AWS_EC2_INSTANCE_ID=